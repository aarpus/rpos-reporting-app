{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rpos-reporting-app",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"AUTH_URL": "https://rpos-reporting-app.webacc.workers.dev",
		"AUTH_TRUST_HOST": "true"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "1ceaaa0247ce42188d195106903bef2e"
		}
	],
	"observability": {
		"enabled": true
	}
}
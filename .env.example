# PostgreSQL must be running. The create command connects to the postgres database.
# DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/reporting_dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST/reporting_dashboard?sslmode=require
AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=AquflFqou1S0RaHuxZ7AiGcayWClytbc+6UIXAMrySk=
# Set true only behind a trusted reverse proxy that controls the Host header.
# AUTH_TRUST_HOST=true

# Used only by npm run db:create-user. Remove ADMIN_PASSWORD after creating the account.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Web Push. Generate the key pair with `npm run push:generate-vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BMU3InRGtIfq_H1JfQjpWArzHmK9ubOh5n67krP06AyKu45SoDgh00DpnyqqxXjDLCxGaPdxpim_z_56VOwUQrk
VAPID_PRIVATE_KEY=F0X3A9GpumwpcIm9HQG2sAMDcqNHTEX5s3G25T8FZxc
VAPID_SUBJECT=mailto:admin@example.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POS_CREDENTIAL_ENCRYPTION_KEY=C7wNi0KAPm47wlCMvGjihNFfL6op281wiWCpHfZZVx4=

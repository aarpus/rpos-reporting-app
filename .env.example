# PostgreSQL must be running. The create command connects to the postgres database.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/reporting_dashboard
AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Set true only behind a trusted reverse proxy that controls the Host header.
# AUTH_TRUST_HOST=true

# Used only by npm run db:create-user. Remove ADMIN_PASSWORD after creating the account.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

{
  "name": "reporting_dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "node scripts/cloudflare.mjs build && node scripts/cloudflare.mjs preview",
    "deploy": "node scripts/cloudflare.mjs build && node scripts/cloudflare.mjs deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:create": "node scripts/database.mjs create",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:deploy": "prisma migrate deploy",
    "db:create-user": "node scripts/database.mjs create-user",
    "test:auth": "node --test tests/password.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "@internationalized/date": "^3.12.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailgrids/icons": "^2.0.1",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.136.3"
  }
}
